{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "CHANGE_ME_WITH_ENV_JWT_KEY",
    "Issuer": "EducenAPI",
    "Audience": "EducenClient",
    "ExpireMinutes": 60
  },
  "SystemApiKey": "CHANGE_ME_WITH_ENV_SYSTEM_API_KEY",
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AdminConnection": "Server=localhost;Database=EducenAdmin;Trusted_Connection=True;TrustServerCertificate=True;",
    "DefaultTenantConnection": "Server=localhost;Database=EducenV2;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Email": "your-email@example.com",
    "Password": "your-app-password"
  },
  "PaymentGateways": {
    "VNPay": {
      "TmnCode": "CHANGE_ME_VNPAY_TMN_CODE",
      "HashSecret": "CHANGE_ME_VNPAY_HASH_SECRET",
      "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
      "ApiUrl": "https://sandbox.vnpayment.vn/merchant_webapi/api/transaction",
      "ReturnUrl": "http://localhost:5173/payment/result",
      "FrontendReturnUrl": "http://localhost:5173/payment/result",
      "IpnUrl": "http://localhost:5106/api/payments/vnpay/callback"
    }
  },
  "RefundPolicy": {
    "SubscriptionGraceDays": 7
  },
  "ZaloOA": {
    "EncryptionKey": "CHANGE_ME_ZALO_ENCRYPTION_KEY"
  }
}
